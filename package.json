{
  "name": "ladoo-mcp",
  "version": "0.1.0",
  "description": "The official Ladoo MCP server: work with your Ladoo AI receptionist's calls, people, agents, knowledge and bookings from Claude, Cursor, VS Code or any MCP client.",
  "keywords": [
    "ladoo",
    "mcp",
    "model-context-protocol",
    "ai-receptionist",
    "claude",
    "cursor"
  ],
  "homepage": "https://tryladoo.com/docs/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TryLadoo/ladoo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/TryLadoo/ladoo-mcp/issues"
  },
  "license": "MIT",
  "author": "Ladoo LLC",
  "mcpName": "io.github.TryLadoo/ladoo-mcp",
  "type": "module",
  "bin": {
    "ladoo-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --experimental-strip-types src/index.ts",
    "generate": "openapi-typescript openapi/openapi-2026-11-16.json -o src/generated/openapi.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
