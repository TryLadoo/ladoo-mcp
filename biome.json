{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["**", "!dist", "!src/generated", "!openapi", "!coverage"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "off" }
    }
  },
  "overrides": [{ "includes": ["src/**"], "linter": { "rules": { "suspicious": { "noExplicitAny": "error" } } } }]
}
